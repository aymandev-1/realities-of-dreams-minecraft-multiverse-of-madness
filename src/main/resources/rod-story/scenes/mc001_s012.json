  "dialogues": {
    "s12_gates": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "I've never seen so many people in one place.",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "Try not to stare.",
          "next": "l02"
        },
        "l02": {
          "speaker": "bram",
          "text": "I'm looking for the best place to eat.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "Some things never change."
        }
      }
    },
    "s12_amb_bread": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "merchant_1",
          "text": "Bread from the river farms! Still warm!"
        }
      }
    },
    "s12_amb_shook": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "valebridge_citizen_1",
          "text": "They say the ground shook as far as the harbour last week."
        }
      }
    },
    "s12_amb_carts": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "eldervale_royal_guard_1",
          "text": "Keep the street clear for the envoys' carts."
        }
      }
    },
    "s12_amb_caravan": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "valebridge_citizen_3",
          "text": "Firstbrook folk? You're the ones who saved that caravan."
        }
      }
    },
    "s12_archivist": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "eldervale_official_1",
          "text": "Firstbrook's dossier? The court has been waiting for it.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Everything we found is in there. The monument, the camp, the stone in Sylvaris.",
          "next": "l02"
        },
        "l02": {
          "speaker": "eldervale_official_1",
          "text": "Then it belongs beside the oldest records we keep. Her Majesty will read it today."
        }
      }
    },
    "s12_messenger": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "eldervale_royal_guard_1",
          "text": "Steve of Firstbrook? Her Majesty asks for you and your companions in the council hall.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Lead the way."
        }
      }
    },
    "s12_council": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "queen_aveline",
          "text": "Primordial Steve of Firstbrook.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Your Majesty.",
          "next": "l02"
        },
        "l02": {
          "speaker": "queen_aveline",
          "text": "Rise. I've heard about the caravan you protected.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "Anyone would've done the same.",
          "next": "l04"
        },
        "l04": {
          "speaker": "queen_aveline",
          "text": "Not everyone does.",
          "next": "l05"
        },
        "l05": {
          "speaker": "queen_aveline",
          "text": "Now tell me why six ancient symbols have brought you to my court.",
          "next": "l06"
        },
        "l06": {
          "speaker": "primordial_steve",
          "text": "Something beneath the northern ruins is active. The symbols appear in several locations, and the compass reacts to all of them.",
          "next": "l07"
        },
        "l07": {
          "speaker": "queen_aveline",
          "text": "And you believe those symbols correspond to our civilisations?",
          "next": "l08"
        },
        "l08": {
          "speaker": "liora",
          "text": "We have found matching stonework in Sylvaris.",
          "next": "l09"
        },
        "l09": {
          "speaker": "elara",
          "text": "And evidence of an expedition that vanished while studying it.",
          "next": "l10"
        },
        "l10": {
          "speaker": "queen_aveline",
          "text": "Then the remaining leaders must be informed.",
          "choices": [
            {
              "text": "Cautious: we need to investigate safely.",
              "next": "c_cautious",
              "actions": [
                {
                  "type": "set_flag",
                  "flag": "mc001.s012.choice_cautious"
                }
              ]
            },
            {
              "text": "Urgent: people may already be in danger.",
              "next": "c_urgent",
              "actions": [
                {
                  "type": "set_flag",
                  "flag": "mc001.s012.choice_urgent"
                }
              ]
            },
            {
              "text": "Cooperative: all six must work together.",
              "next": "c_cooperative",
              "actions": [
                {
                  "type": "set_flag",
                  "flag": "mc001.s012.choice_cooperative"
                }
              ]
            }
          ]
        },
        "c_cautious": {
          "speaker": "primordial_steve",
          "text": "We don't understand this discovery. We need to investigate safely.",
          "next": "p0"
        },
        "c_urgent": {
          "speaker": "primordial_steve",
          "text": "People may already be in danger. We cannot afford to wait.",
          "next": "p0"
        },
        "c_cooperative": {
          "speaker": "primordial_steve",
          "text": "All six civilisations need to investigate this together.",
          "next": "p0"
        },
        "p0": {
          "speaker": "queen_aveline",
          "text": "The past belongs to all of us. Whatever was buried beneath these lands may affect all of us too.",
          "next": "p1"
        },
        "p1": {
          "speaker": "primordial_steve",
          "text": "Then we'll find the truth together.",
          "next": "p2"
        },
        "p2": {
          "speaker": "queen_aveline",
          "text": "Begin with what Eldervale has kept. The sealed royal records are open to you."
        }
      }
    },
    "s12_charter": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "'Six crowns were given the keeping of what came before.' Given by whom?",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "It doesn't say. Only that the six kingdoms were made keepers."
        }
      }
    },
    "s12_chronicle": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "Valebridge was raised on older stones. The chronicle calls them the foundations of the first builders.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Builders before Eldervale."
        }
      }
    },
    "s12_inventory": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "'One stone, carved, not to be moved. Five sent away to five keepers.' They catalogued the same symbols.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "So the kingdoms didn't make these marks. They were handed them."
        }
      }
    },
    "s12_inheritance": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "Every kingdom tells its history as if it began with itself.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "But these records say we inherited something. Knowledge from someone older than all six.",
          "next": "l02"
        },
        "l02": {
          "speaker": "elara",
          "text": "Then the other kingdoms will have pieces of it too.",
          "next": "l03"
        },
        "l03": {
          "speaker": "eldervale_official_1",
          "text": "Her Majesty's orders. Thane Garrick writes that his miners have found a carved mechanism beneath Irondeep. You are to go to him, with the vault stone.",
          "next": "l04"
        },
        "l04": {
          "speaker": "liora",
          "text": "Take this as well. It's a rubbing of the stone in our grove. It's as close as Sylvaris can come to sending the stone itself.",
          "next": "l05"
        },
        "l05": {
          "speaker": "primordial_steve",
          "text": "Then Irondeep is next."
        }
      }
    }
  },
