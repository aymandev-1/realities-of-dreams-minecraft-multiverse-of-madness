        "l00": {
          "speaker": "stonecrown_guard_1",
          "text": "A writ from Eldervale? The Thane's expecting you. Forge Hall, past the market terraces.",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "Took you long enough. I came by the mountain road with Firstbrook's records.",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "Orin! You came all this way?",
          "next": "l03"
        },
        "l03": {
          "speaker": "orin",
          "text": "Somebody has to stop you touching the wrong thing."
        }
      }
    },
    "s13_garrick": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "I was told you found something worth dragging me away from my forge.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Queen Aveline sent us. She says your miners found something.",
          "next": "l02"
        },
        "l02": {
          "speaker": "thane_garrick",
          "text": "My miners discovered this beneath the oldest foundations of Irondeep.",
          "actions": [
            {
              "type": "npc_look",
              "character": "thane_garrick",
              "location": "workbench_front"
            }
          ],
          "next": "l03"
        },
        "l03": {
          "speaker": "orin",
          "text": "That carving...",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "It's the same symbol.",
          "next": "l05"
        },
        "l05": {
          "speaker": "thane_garrick",
          "text": "Exactly. Which is why I want to know how you found another.",
          "next": "l06"
        },
        "l06": {
          "speaker": "thane_garrick",
          "text": "Our deepest halls are older than the current kingdom. There are tunnels nobody remembers building.",
          "next": "l07"
        },
        "l07": {
          "speaker": "primordial_steve",
          "text": "Could they connect to the northern monument?",
          "next": "l08"
        },
        "l08": {
          "speaker": "thane_garrick",
          "text": "Not through any passage my miners know.",
          "next": "l09"
        },
        "l09": {
          "speaker": "orin",
          "text": "The markings are consistent, though. Same spacing. Same geometry.",
          "next": "l10"
        },
        "l10": {
          "speaker": "thane_garrick",
          "text": "Then somebody put considerable effort into making them identical."
        }
      }
    },
    "s13_machine": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "This isn't decoration. Look at the teeth on that edge. It's part of a machine.",
          "next": "l01"
        },
        "l01": {
          "speaker": "thane_garrick",
          "text": "Stonecrown makes the finest gears in the six kingdoms. We never made this."
        }
      }
    },
    "s13_sealed": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "That pattern resembles something I once saw in our oldest mine.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "What was it?",
          "next": "l02"
        },
        "l02": {
          "speaker": "thane_garrick",
          "text": "A chamber sealed long before my grandfather's time.",
          "next": "l03"
        },
        "l03": {
          "speaker": "elara",
          "text": "Can you open it?",
          "next": "l04"
        },
        "l04": {
          "speaker": "thane_garrick",
          "text": "Perhaps. But I'd rather discover why it was sealed first.",
          "next": "l05"
        },
        "l05": {
          "speaker": "thane_garrick",
          "text": "The Old Deeps flooded generations ago when the drains failed. If you want that chamber, we drain it first.",
          "next": "l06"
        },
        "l06": {
          "speaker": "primordial_steve",
          "text": "Then we drain it."
        }
      }
    },
    "s13_older": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "These machines weren't built by Stonecrown.",
          "next": "l01"
        },
        "l01": {
          "speaker": "thane_garrick",
          "text": "No. My ancestors found them and swore to guard them. We built Irondeep around something older.",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "The same builders who left the monument.",
          "next": "l03"
        },
        "l03": {
          "speaker": "thane_garrick",
          "text": "Then Stonecrown stands with you. My engineers, my miners, whatever you need.",
          "next": "l04"
        },
        "l04": {
          "speaker": "thane_garrick",
          "text": "Solkar's scholars have asked about that symbol for years. Sahir of Sunspire would trade his library for a look at this plate."
        }
      }
    },
    "s13_city_rails": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "irondeep_miner_3",
          "text": "Mind the rails! Ore carts don't stop for visitors."
        }
      }
    },
    "s13_city_shafts": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "irondeep_miner_6",
          "text": "The deep shafts have been groaning since the tremors."
        }
      }
    },
    "s13_city_lift": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "stonecrown_engineer_1",
          "text": "Lift's running on the old counterweights again. Don't lean on the rail."
        }
      }
    },
    "s13_city_bridges": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "irondeep_miner_4",
          "text": "Every bridge in the hold is checked at each shift change. Walk easy."
        }
      }
    },
    "s13_city_forge": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "irondeep_miner_7",
          "text": "Keep clear of the forge mouths. The heat carries further than you think."
        }
      }
    }
  },
