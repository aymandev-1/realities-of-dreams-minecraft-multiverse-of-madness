  "dialogues": {
    "s11_strange_roads": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "merchant_1",
          "text": "You came from Sylvaris?",
          "next": "l01"
        },
        "l01": {
          "speaker": "liora",
          "text": "The eastern outpost.",
          "next": "l02"
        },
        "l02": {
          "speaker": "merchant_1",
          "text": "Then you may know why the roads have been so strange lately.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "Strange how?",
          "next": "l04"
        },
        "l04": {
          "speaker": "merchant_1",
          "text": "People disappearing. Animals refusing to cross certain bridges. And raiders taking advantage of it.",
          "next": "l05"
        },
        "l05": {
          "speaker": "bram",
          "text": "Speaking of raiders..."
        }
      }
    },
    "s11_standoff": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "raider_leader_1",
          "text": "Leave the supplies and walk away!",
          "next": "l01"
        },
        "l01": {
          "speaker": "bram",
          "text": "Wrong caravan.",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "Nobody needs to get hurt. Let the travellers pass.",
          "next": "l03"
        },
        "l03": {
          "speaker": "raider_leader_1",
          "text": "You've got a lot of confidence for someone holding a pickaxe.",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "It's a very good pickaxe."
        }
      }
    },
    "s11_wagon": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "Steve! Keep them away from the wagon!"
        }
      }
    },
    "s11_ridge": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "elara",
          "text": "Two coming from the ridge!",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "I've got them!"
        }
      }
    },
    "s11_hold_road": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "The merchants are moving! Hold the road!"
        }
      }
    },
    "s11_retreat": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "raider_leader_1",
          "text": "This road isn't worth dying for!"
        }
      }
    },
    "s11_after": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "Not bad.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "You sound surprised.",
          "next": "l02"
        },
        "l02": {
          "speaker": "bram",
          "text": "I'm always surprised when your plans work.",
          "next": "l03"
        },
        "l03": {
          "speaker": "liora",
          "text": "Everyone's safe.",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "Then let's get them home."
        }
      }
    }
  },
