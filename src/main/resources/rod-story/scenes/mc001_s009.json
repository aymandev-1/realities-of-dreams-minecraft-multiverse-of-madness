  "dialogues": {
    "nobody_here": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "Nobody here.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "The fire's cold, but these supplies haven't been here long.",
          "next": "c"
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "They left in a hurry.",
          "next": "d"
        },
        "d": {
          "speaker": "bram",
          "text": "Or somebody made them leave."
        }
      }
    },
    "journal_talk": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "These people were mapping the same markings we found.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "How do you know?",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "Look at this drawing.",
          "next": "d"
        },
        "d": {
          "speaker": "bram",
          "text": "Who sent them?",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "The last page is missing.",
          "next": "f"
        },
        "f": {
          "speaker": "elara",
          "text": "Maybe they carried it with them."
        }
      }
    },
    "signal": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "There it is again.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "The same signal.",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "And it's getting stronger."
        }
      }
    },
    "sylvaris": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "Sylvaris.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "The forest civilisation?",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "Someone from Sylvaris knows about this site."
        }
      }
    }
