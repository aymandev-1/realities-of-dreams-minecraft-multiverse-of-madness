  "dialogues": {
    "s18_camp": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "I've never seen so many people working together.",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "Let's hope they stay that way.",
          "next": "l02"
        },
        "l02": {
          "speaker": "orin",
          "text": "They will if nobody touches the wrong thing.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "You keep saying that.",
          "next": "l04"
        },
        "l04": {
          "speaker": "orin",
          "text": "And you keep reaching toward mysterious glowing stones.",
          "next": "l05"
        },
        "l05": {
          "speaker": "primordial_steve",
          "text": "Fair point.",
          "next": "l06"
        },
        "l06": {
          "speaker": "thane_garrick",
          "text": "My engineers found an entrance beneath the eastern foundation.",
          "next": "l07"
        },
        "l07": {
          "speaker": "sahir",
          "text": "Does it match the plans?",
          "next": "l08"
        },
        "l08": {
          "speaker": "thane_garrick",
          "text": "Too closely for coincidence."
        }
      }
    },
    "s18_descent": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "elara",
          "text": "The air feels different down here.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Colder?",
          "next": "l02"
        },
        "l02": {
          "speaker": "elara",
          "text": "Still. Like nobody's disturbed it in centuries.",
          "next": "l03"
        },
        "l03": {
          "speaker": "bram",
          "text": "Let's keep it that way.",
          "next": "l04"
        },
        "l04": {
          "speaker": "orin",
          "text": "We came here specifically to disturb it.",
          "next": "l05"
        },
        "l05": {
          "speaker": "bram",
          "text": "You know what I mean."
        }
      }
    },
    "s18_conduits": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "Copper channels, older than any mine of mine. And they're humming.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "The deep note. The Sunspire pages spoke of it."
        }
      }
    },
    "s18_clock": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "This mechanism has been turning for centuries and it hasn't moved an inch.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "Or it only moves when time does something it shouldn't."
        }
      }
    },
    "s18_twins": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "elara",
          "text": "Two circles. Exactly the same.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "A door and its echo, perhaps."
        }
      }
    },
    "s18_warning": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "Another warning. Whoever built this was very worried about something."
        }
      }
    },
    "s18_symbols": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "Six symbols. Six records.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "The carvings tell us how to align them.",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "And what's behind the door?",
          "next": "l03"
        },
        "l03": {
          "speaker": "orin",
          "text": "That's what we're here to learn."
        }
      }
    },
    "s18_carving": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "Eldervale's tower at the crown. Then sunwise: the leaf of Sylvaris, the anvil of Stonecrown, the sun of Solkar, the flame of Veyrath, the wave of Thalassia."
        }
      }
    },
    "s18_door": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "Everybody stand back!",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "Steve!",
          "next": "l02"
        },
        "l02": {
          "speaker": "orin",
          "text": "It worked.",
          "next": "l03"
        },
        "l03": {
          "speaker": "sahir",
          "text": "After all these generations..."
        }
      }
    },
    "s18_chamber": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "What is that?",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "I haven't the faintest idea.",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "The records called this place a boundary.",
          "next": "l03"
        },
        "l03": {
          "speaker": "elara",
          "text": "Between what?",
          "next": "l04"
        },
        "l04": {
          "speaker": "sahir",
          "text": "That's the part they never explained."
        }
      }
    },
    "s18_grooves": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "Worn smooth. Something heavy crossed this bridge, many times."
        }
      }
    },
    "s18_plinth": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "The same six emblems, carved at its foot."
        }
      }
    },
    "s18_survive": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "This chamber has survived longer than any structure I've ever seen.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Then let's make sure it survives today."
        }
      }
    },
    "s18_compass": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "Don't activate anything yet.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "I wasn't planning to.",
          "next": "l02"
        },
        "l02": {
          "speaker": "elara",
          "text": "Steve..."
        }
      }
    },
    "s18_amb_rope": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "expedition_worker_2",
          "text": "Rope's for going down slowly. Not for going down fast."
        }
      }
    },
    "s18_amb_ranger": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "sylvaris_ranger_1",
          "text": "Liora wants the treeline watched. Nobody comes up that causeway unseen."
        }
      }
    },
    "s18_amb_eng": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "stonecrown_engineer_2",
          "text": "Every beam you fit is one less we have to carry back up."
        }
      }
    }
  },
