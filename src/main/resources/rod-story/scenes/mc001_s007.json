  "dialogues": {
    "three_compasses": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "orin",
          "text": "I've tried three compasses. Every single one is wrong.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Maybe they're all broken.",
          "next": "c"
        },
        "c": {
          "speaker": "orin",
          "text": "All three? At exactly the same time?",
          "next": "d"
        },
        "d": {
          "speaker": "elara",
          "text": "Orin, what are they pointing toward?"
        }
      }
    },
    "buried": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "orin",
          "text": "Whatever is buried beneath that structure."
        }
      }
    },
    "below": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "The signal isn't ahead of us.",
          "next": "b"
        },
        "b": {
          "speaker": "orin",
          "text": "Then where?",
          "next": "c"
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "Below.",
          "next": "d"
        },
        "d": {
          "speaker": "elara",
          "text": "Below the monument?",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "Farther than that, I think."
        }
      }
    },
    "six_points": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "orin",
          "text": "Did you both see that?",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "Six points.",
          "next": "c"
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "Like the monument carving.",
          "next": "d"
        },
        "d": {
          "speaker": "orin",
          "text": "We're going to need information from outside Firstbrook.",
          "next": "e"
        },
        "e": {
          "speaker": "elara",
          "text": "Maybe the other kingdoms have seen these symbols."
        }
      }
    }
