  "dialogues": {
    "tracks": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "Look at this.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "A traveller?",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "Maybe. But the tracks stop here.",
          "next": "d"
        },
        "d": {
          "speaker": "primordial_steve",
          "text": "They could've climbed the ridge.",
          "next": "e"
        },
        "e": {
          "speaker": "elara",
          "text": "Then where are the marks on the rock?",
          "next": "f"
        },
        "f": {
          "speaker": "primordial_steve",
          "text": "You think somebody vanished?",
          "next": "g"
        },
        "g": {
          "speaker": "elara",
          "text": "I think something happened here that neither of us understands."
        }
      }
    },
    "valley": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "I know this valley. I've crossed it since I was a child.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "You make it sound like the valley betrayed you.",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "Maybe that's exactly how it feels."
        }
      }
    },
    "clue_lantern": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "A scout's lantern. Still half full of oil.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "Nobody leaves a lantern behind out here. Look at those rocks. Someone climbed them."
        }
      }
    },
    "clue_pack": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "A bedroll, a cold fire and a pack. The scout was here.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "Then this is the last place anyone saw them... if anyone did."
        }
      }
    },
    "clue_marker": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "One of the old survey markers. Snapped clean through.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "These have stood for a hundred years. And there's another stone further up. Look at it."
        }
      }
    },
    "reacted": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "Did you see that?",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "Yes.",
          "next": "c"
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "They reacted to me.",
          "next": "d"
        },
        "d": {
          "speaker": "elara",
          "text": "Or to the equipment you're carrying. We don't know yet."
        }
      }
    }
  },
