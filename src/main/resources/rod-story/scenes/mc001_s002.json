  "dialogues": {
    "rowan_warning": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elder_rowan",
          "text": "Steve, I've been looking everywhere for you.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "What's wrong?",
          "next": "c"
        },
        "c": {
          "speaker": "elder_rowan",
          "text": "Something happened near the old northern ruins before sunrise.",
          "next": "d"
        },
        "d": {
          "speaker": "elara",
          "text": "The ruins? Nobody's been working there.",
          "next": "e"
        },
        "e": {
          "speaker": "elder_rowan",
          "text": "Exactly. The ground shook, and the watchtower reported strange lights beneath the stone.",
          "next": "f"
        },
        "f": {
          "speaker": "primordial_steve",
          "text": "An earthquake?",
          "next": "g"
        },
        "g": {
          "speaker": "elder_rowan",
          "text": "I lived through earthquakes when I was younger. This felt different.",
          "next": "h"
        },
        "h": {
          "speaker": "elara",
          "text": "Different how?",
          "next": "i"
        },
        "i": {
          "speaker": "elder_rowan",
          "text": "Almost deliberate."
        }
      }
    },
    "clue_wall": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "These cracks are fresh. The stones were pushed up from below, not knocked down.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "Nothing in Firstbrook is heavy enough to do that."
        }
      }
    },
    "clue_compass": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "The surveyor's compass. The needle won't settle.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "It keeps swinging north... then away again."
        }
      }
    },
    "clue_report": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "The night watch's report. 'Two tremors before dawn. Light seen beneath the stones of the northern ridge. Gone within moments.'",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "They saw it too. So it wasn't just the ground."
        }
      }
    },
    "bram_report": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "The northern path isn't safe. Loose rocks came down just before dawn.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Anyone hurt?",
          "next": "c"
        },
        "c": {
          "speaker": "bram",
          "text": "No. I closed the trail before the traders reached it.",
          "next": "d"
        },
        "d": {
          "speaker": "elder_rowan",
          "text": "Good. I'd rather lose a morning of trading than a single life.",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "I'll have a look.",
          "next": "f"
        },
        "f": {
          "speaker": "elder_rowan",
          "text": "Not alone. We need to know what we're dealing with."
        }
      }
    },
    "heading_north": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "That's where I was heading.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Then let's find out what happened.",
          "next": "c"
        },
        "c": {
          "speaker": "elder_rowan",
          "text": "First, prepare properly. There'll be no heroics today."
        }
      }
    }
  },
