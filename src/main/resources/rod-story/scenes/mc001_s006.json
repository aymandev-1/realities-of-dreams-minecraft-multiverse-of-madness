  "dialogues": {
    "approach": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "That's bigger than it looked from the watchtower.",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "The outer walls weren't visible yesterday.",
          "next": "c"
        },
        "c": {
          "speaker": "orin",
          "text": "They've been buried for generations. The disturbance must've exposed them.",
          "next": "d"
        },
        "d": {
          "speaker": "primordial_steve",
          "text": "Then the ground didn't just shake. Something underneath moved.",
          "next": "e"
        },
        "e": {
          "speaker": "orin",
          "text": "That's what worries me."
        }
      }
    },
    "six_towers": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "Six towers?",
          "next": "b"
        },
        "b": {
          "speaker": "orin",
          "text": "Possibly. Or six settlements.",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "Look at their shapes. That one resembles the towers of Eldervale.",
          "next": "d"
        },
        "d": {
          "speaker": "bram",
          "text": "And that one looks like the old Stonecrown fortress.",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "Why would somebody carve all six here?",
          "next": "f"
        },
        "f": {
          "speaker": "orin",
          "text": "I don't know. But somebody wanted them remembered together."
        }
      }
    },
    "move_away": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "Steve! Move away!"
        }
      }
    },
    "didnt_touch": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "I didn't touch anything.",
          "next": "b"
        },
        "b": {
          "speaker": "orin",
          "text": "I saw. It started before your hand reached the stone.",
          "next": "c"
        },
        "c": {
          "speaker": "bram",
          "text": "Then we're not staying here after dark."
        }
      }
    }
  },
