  "dialogues": {
    "s17_centre": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "That's everything.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "Not quite.",
          "next": "l02"
        },
        "l02": {
          "speaker": "elara",
          "text": "The centre is missing.",
          "next": "l03"
        },
        "l03": {
          "speaker": "thane_garrick",
          "text": "A seventh stone?",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "Or something that was never meant to be removed."
        }
      }
    },
    "s17_interpretations": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "Stonecrown records describe it as a foundation.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "Solkar's scholars called it a boundary.",
          "next": "l02"
        },
        "l02": {
          "speaker": "captain_maren",
          "text": "Our maps identify it as a navigation marker.",
          "next": "l03"
        },
        "l03": {
          "speaker": "liora",
          "text": "Sylvaris preserved it as a warning.",
          "next": "l04"
        },
        "l04": {
          "speaker": "lord_kaelen",
          "text": "Veyrath's oldest accounts refer to a sealed inheritance.",
          "next": "l05"
        },
        "l05": {
          "speaker": "primordial_steve",
          "text": "You're all describing different parts of the same thing."
        }
      }
    },
    "s17_light": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "They're not contradicting one another.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "The foundation supports the structure.",
          "next": "l02"
        },
        "l02": {
          "speaker": "captain_maren",
          "text": "The marker shows where it is.",
          "next": "l03"
        },
        "l03": {
          "speaker": "liora",
          "text": "The warning explains why it should remain undisturbed.",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "And the boundary?",
          "next": "l05"
        },
        "l05": {
          "speaker": "sahir",
          "text": "That part we still don't understand."
        }
      }
    },
    "s17_builders": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "There's writing in the grooves, finer than any chisel we own.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "'We who built before the crowns leave this to six keepers. Keep it apart. Keep it whole. Do not open the door.'",
          "next": "l02"
        },
        "l02": {
          "speaker": "thane_garrick",
          "text": "Before the crowns. Before any of us.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "The Ancient Builders. They made the gateway. Our kingdoms only inherited the pieces.",
          "next": "l04"
        },
        "l04": {
          "speaker": "lord_kaelen",
          "text": "And swore oaths they never understood.",
          "next": "l05"
        },
        "l05": {
          "speaker": "lord_kaelen",
          "text": "I owe this council an admission.",
          "next": "l06"
        },
        "l06": {
          "speaker": "queen_aveline",
          "text": "We're listening.",
          "next": "l07"
        },
        "l07": {
          "speaker": "lord_kaelen",
          "text": "I was prepared to treat this discovery as another dispute between kingdoms.",
          "next": "l08"
        },
        "l08": {
          "speaker": "primordial_steve",
          "text": "And now?",
          "next": "l09"
        },
        "l09": {
          "speaker": "lord_kaelen",
          "text": "Now I believe there's something far more important beneath the valley.",
          "next": "l10"
        },
        "l10": {
          "speaker": "liora",
          "text": "Then perhaps we can investigate it together.",
          "next": "l11"
        },
        "l11": {
          "speaker": "lord_kaelen",
          "text": "We can try."
        }
      }
    },
    "s17_plan": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "Here. The central intersection.",
          "next": "l01"
        },
        "l01": {
          "speaker": "thane_garrick",
          "text": "My engineers can help secure the excavation.",
          "next": "l02"
        },
        "l02": {
          "speaker": "captain_maren",
          "text": "I'll organise transport.",
          "next": "l03"
        },
        "l03": {
          "speaker": "sahir",
          "text": "I'll bring the translated records.",
          "next": "l04"
        },
        "l04": {
          "speaker": "liora",
