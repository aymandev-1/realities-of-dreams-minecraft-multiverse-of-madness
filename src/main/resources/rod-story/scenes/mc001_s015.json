  "dialogues": {
    "s15_warm": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "Is it always this warm?",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "Don't touch the walls."
        }
      }
    },
    "s15_amb_channels": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "emberhold_citizen_3",
          "text": "Mind the channels, outlander. The stone's hotter than it looks."
        }
      }
    },
    "s15_amb_sheathed": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "veyrath_guard_3",
          "text": "The Lord receives you in the Ember Hall. Weapons stay sheathed."
        }
      }
    },
    "s15_amb_grandmother": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "emberhold_citizen_8",
          "text": "Eldervale's queen, here? My grandmother won't believe it."
        }
      }
    },
    "s15_amb_bellows": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "emberhold_citizen_1",
          "text": "The bellows never rest in Emberhold. Neither do we."
        }
      }
    },
    "s15_amb_colours": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "emberhold_citizen_5",
          "text": "Blue and gold for the Lord's house. Black for the stone that bore us."
        }
      }
    },
    "s15_council": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "lord_kaelen",
          "text": "So this is the discovery everyone has been whispering about.",
          "actions": [
            {
              "type": "npc_look",
              "character": "elara",
              "location": "kaelen_throne"
            },
            {
              "type": "npc_look",
              "character": "bram",
              "location": "kaelen_throne"
            }
          ],
          "next": "l01"
        },
        "l01": {
          "speaker": "queen_aveline",
          "text": "You were invited to examine the evidence.",
          "next": "l02"
        },
        "l02": {
          "speaker": "lord_kaelen",
          "text": "I was invited after the others had already begun their investigation.",
          "actions": [
            {
              "type": "npc_look",
              "character": "queen_aveline",
              "location": "kaelen_throne"
            }
          ],
          "next": "l03"
        },
        "l03": {
          "speaker": "thane_garrick",
          "text": "We barely understand what we found.",
          "actions": [
            {
              "type": "npc_look",
              "character": "thane_garrick",
              "location": "kaelen_throne"
            }
          ],
          "next": "l04"
        },
        "l04": {
          "speaker": "lord_kaelen",
          "text": "And yet you've already carried pieces of it into another kingdom.",
          "actions": [
            {
              "type": "npc_move",
              "character": "lord_kaelen",
              "location": "kaelen_table"
            }
          ],
          "next": "l05"
        },
        "l05": {
          "speaker": "lord_kaelen",
          "text": "I will not allow an ancient Veyrath legacy to be claimed by whoever reached it first.",
          "actions": [
            {
              "type": "npc_look",
              "character": "sahir",
              "location": "kaelen_table"
            }
          ],
          "next": "l06"
        },
        "l06": {
          "speaker": "primordial_steve",
          "text": "Nobody's claiming anything.",
          "next": "l07"
        },
        "l07": {
          "speaker": "lord_kaelen",
          "text": "Not yet.",
          "next": "l08"
        },
        "l08": {
          "speaker": "liora",
          "text": "The evidence was discovered across several territories. This concerns us all.",
          "actions": [
            {
              "type": "npc_look",
              "character": "liora",
              "location": "kaelen_table"
            }
          ],
          "next": "l09"
        },
        "l09": {
          "speaker": "lord_kaelen",
          "text": "That is easy to say when your people already hold part of it.",
          "actions": [
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "liora_hall"
            }
          ],
          "next": "l10"
        },
        "l10": {
          "speaker": "queen_aveline",
          "text": "Enough. We will establish a joint expedition and keep an open record of every discovery.",
          "actions": [
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "aveline_hall"
            }
          ],
          "next": "l11"
        },
        "l11": {
          "speaker": "lord_kaelen",
          "text": "Then Veyrath expects equal representation.",
          "next": "l12"
        },
        "l12": {
          "speaker": "primordial_steve",
          "text": "That's fair.",
          "next": "l13"
        },
        "l13": {
          "speaker": "lord_kaelen",
          "text": "And who gave you authority to lead this?",
          "actions": [
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "hall_inside"
            }
          ],
          "next": "l14"
        },
        "l14": {
          "speaker": "primordial_steve",
          "text": "Nobody. I was looking into something dangerous near my home.",
          "next": "l15"
        },
        "l15": {
          "speaker": "primordial_steve",
          "text": "If you know more about it, help us.",
          "next": "l16"
        },
        "l16": {
          "speaker": "lord_kaelen",
          "text": "Then tell me why Veyrath should open its vault to strangers.",
          "choices": [
            {
              "text": "The records show all six kingdoms kept a piece. (Evidence)",
              "next": "ev",
              "actions": [
                {
                  "type": "set_flag",
                  "flag": "mc001.kaelen.approach_evidence"
                },
                {
                  "type": "add_value",
                  "key": "mc001.kaelen.trust",
                  "amount": 1
                }
              ]
            },
            {
              "text": "Veyrath kept its piece longest and best. (Respect)",
              "next": "re",
              "actions": [
                {
                  "type": "set_flag",
                  "flag": "mc001.kaelen.approach_respect"
                },
                {
                  "type": "add_value",
                  "key": "mc001.kaelen.trust",
                  "amount": 1
                }
              ]
            },
            {
              "text": "Something else may wake it first. (Warning)",
              "next": "wa",
              "actions": [
                {
                  "type": "set_flag",
                  "flag": "mc001.kaelen.approach_warning"
                }
              ]
            }
          ]
        },
        "ev": {
          "speaker": "primordial_steve",
          "text": "Because the records show all six kingdoms were given a piece to keep. Yours too.",
          "next": "ev_k"
        },
        "ev_k": {
          "speaker": "lord_kaelen",
          "text": "Records. Scholars' ink. Show me, then."
        },
        "re": {
          "speaker": "primordial_steve",
          "text": "Because Veyrath kept its piece longer and better than anyone. We need what you know, not just the stone.",
          "next": "re_k"
        },
        "re_k": {
          "speaker": "lord_kaelen",
          "text": "Flattery from Firstbrook. Still, it happens to be true."
        },
        "wa": {
          "speaker": "primordial_steve",
          "text": "Because if we don't understand it, something else may wake it first.",
          "next": "wa_k"
        },
        "wa_k": {
          "speaker": "lord_kaelen",
          "text": "You think I haven't lain awake over that? Prove you understand it better than I do."
        }
      }
    },
    "s15_oath": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "lord_kaelen",
          "text": "Six kingdoms, one pattern. Very well. You've earned the truth.",
          "actions": [
            {
              "type": "npc_look",
              "character": "thane_garrick",
              "location": "kaelen_table"
            },
            {
              "type": "npc_look",
              "character": "liora",
              "location": "kaelen_table"
            }
          ],
          "next": "l01"
        },
        "l01": {
          "speaker": "lord_kaelen",
          "text": "My house swore an oath before Emberhold had walls. Keep the Ember Key apart from the door, and never carry it in anger.",
          "actions": [
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "vault_mouth"
            }
          ],
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "Door? What door?",
          "next": "l03"
        },
        "l03": {
          "speaker": "lord_kaelen",
          "text": "The oath never said. Only that the key and the door must not meet by chance.",
          "actions": [
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "table"
            }
          ],
          "next": "l04"
        },
        "l04": {
          "speaker": "elara",
          "text": "You've guarded it all this time without knowing why?",
          "actions": [
            {
              "type": "npc_look",
              "character": "elara",
              "location": "kaelen_table"
            }
          ],
          "next": "l05"
        },
        "l05": {
          "speaker": "lord_kaelen",
          "text": "Veyrath keeps its word. That is the why.",
          "next": "l06"
        },
        "l06": {
          "speaker": "lord_kaelen",
          "text": "Every kingdom calls Veyrath the dangerous one. Fire, forges, temper. Yet we kept the most dangerous thing of all, and kept it safe.",
          "actions": [
            {
              "type": "npc_look",
              "character": "queen_aveline",
              "location": "kaelen_table"
            },
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "vault_mouth"
            }
          ]
        }
      }
    },
    "s15_closing": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "lord_kaelen",
          "text": "Very well. Veyrath will send its experts.",
          "next": "l01"
        },
        "l01": {
          "speaker": "queen_aveline",
          "text": "Then we have an agreement.",
          "next": "l02"
        },
        "l02": {
          "speaker": "lord_kaelen",
          "text": "An agreement to investigate. Not to surrender our interests.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "That's a start.",
          "next": "l04"
        },
        "l04": {
          "speaker": "lord_kaelen",
          "text": "And the key does not leave my sight. Where it goes, Veyrath goes.",
          "actions": [
            {
              "type": "npc_look",
              "character": "lord_kaelen",
              "location": "key_glow"
            }
          ],
          "next": "l05"
        },
        "l05": {
          "speaker": "queen_aveline",
          "text": "Captain Maren sends word from Tidewatch. Her divers have found something at the old coastal watch.",
          "next": "l06"
        },
        "l06": {
          "speaker": "primordial_steve",
          "text": "The last piece."
        }
      }
    }
  },
