  "dialogues": {
    "valley_edge": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "Beautiful, isn't it?",
          "next": "b"
        },
        "b": {
          "speaker": "bram",
          "text": "Beautiful until you have to cross it carrying supplies.",
          "next": "c"
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "We could build a bridge.",
          "next": "d"
        },
        "d": {
          "speaker": "bram",
          "text": "Of course that's your answer.",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "It's a good answer."
        }
      }
    },
    "beyond": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "Have you ever wondered what's beyond the kingdoms?",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Mountains. Oceans. Probably more mountains.",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "I'm serious.",
          "next": "d"
        },
        "d": {
          "speaker": "primordial_steve",
          "text": "So am I.",
          "next": "e"
        },
        "e": {
          "speaker": "elara",
          "text": "There are maps older than anyone in Firstbrook. Some have places nobody remembers.",
          "next": "f"
        },
        "f": {
          "speaker": "primordial_steve",
          "text": "Then somebody should go see if they're still there.",
          "next": "g"
        },
        "g": {
          "speaker": "elara",
          "text": "I thought you'd say that."
        }
      }
    },
    "tunnel": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "Rowan said you were always getting into trouble as a child.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "He exaggerates.",
          "next": "c"
        },
        "c": {
          "speaker": "bram",
          "text": "He said you tried building a tunnel beneath the village.",
          "next": "d"
        },
        "d": {
          "speaker": "primordial_steve",
          "text": "It would've worked.",
          "next": "e"
        },
        "e": {
          "speaker": "bram",
          "text": "You flooded three houses.",
          "next": "f"
        },
        "f": {
          "speaker": "primordial_steve",
          "text": "I said it would've worked."
        }
      }
    },
    "someones_been_here": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "Someone's been here.",
          "next": "b"
        },
        "b": {
          "speaker": "bram",
          "text": "Recently?",
          "next": "c"
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "Let's find out."
        }
      }
    }
  },
