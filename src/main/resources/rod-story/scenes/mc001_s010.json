  "dialogues": {
    "s10_greeting": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "Travellers from Firstbrook?",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "Liora?",
          "next": "l02"
        },
        "l02": {
          "speaker": "liora",
          "text": "Elara. I hoped the next time we met would be under better circumstances.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "You've been expecting us?",
          "next": "l04"
        },
        "l04": {
          "speaker": "liora",
          "text": "We've been expecting someone to follow the tremors."
        }
      }
    },
    "s10_humming": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "The oldest trees have stood here for generations. Their roots reach farther than our records.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "And?",
          "next": "l02"
        },
        "l02": {
          "speaker": "liora",
          "text": "Yesterday, the ground beneath them started humming.",
          "next": "l03"
        },
        "l03": {
          "speaker": "bram",
          "text": "Humming?",
          "next": "l04"
        },
        "l04": {
          "speaker": "liora",
          "text": "A sound without a source. Some of our watchtowers heard it at the same time.",
          "next": "l05"
        },
        "l05": {
          "speaker": "elara",
          "text": "Did you find anything?",
          "next": "l06"
        },
        "l06": {
          "speaker": "liora",
          "text": "An ancient stone buried beneath the eastern grove. It has the same markings as the drawing you brought.",
          "actions": [
            {
              "type": "hold_item",
              "item": "minecraft:written_book"
            }
          ],
          "next": "l07"
        },
        "l07": {
          "speaker": "liora",
          "text": "Where did you get that?",
          "next": "l08"
        },
        "l08": {
          "speaker": "primordial_steve",
          "text": "An abandoned camp.",
          "next": "l09"
        },
        "l09": {
          "speaker": "liora",
          "text": "Then those explorers may have reached farther than we realised."
        }
      }
    },
    "s10_six_marks": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "Six marks. Six civilisations.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "That's what we thought.",
          "next": "l02"
        },
        "l02": {
          "speaker": "liora",
          "text": "Then this is no longer a matter for Firstbrook alone.",
          "next": "l03"
        },
        "l03": {
          "speaker": "elara",
          "text": "What are you suggesting?",
          "next": "l04"
        },
        "l04": {
          "speaker": "liora",
          "text": "You need the rulers and representatives together before someone makes a terrible mistake."
        }
      }
    },
    "s10_warning": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "liora",
          "text": "Take this to your elders. Ask them to contact the royal court.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Will Sylvaris help?",
          "next": "l02"
        },
        "l02": {
          "speaker": "liora",
          "text": "I'll come myself.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "Then we'll see you there."
        }
      }
    }
  },
