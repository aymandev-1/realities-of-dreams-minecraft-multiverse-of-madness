  "journal": {
    "forest_message": {
      "title": "The Forest's Message",
      "text": "Liora of Sylvaris was waiting for us. Her rangers have heard the ground humming beneath the oldest trees, and they found an ancient stone in the eastern grove with the same markings as the expedition's drawing. We mended a fallen walkway to reach it and fetched an old border record from the watchtower. Six marks: six civilisations. Liora says the rulers must be brought together, and she is coming to the royal court herself."
    }
  }
