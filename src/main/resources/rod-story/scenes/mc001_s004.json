  "dialogues": {
    "orin_markings": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "orin",
          "text": "Before you ask, no, I haven't worked out what happened.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "We haven't asked yet.",
          "next": "c"
        },
        "c": {
          "speaker": "orin",
          "text": "Your faces asked for you.",
          "next": "d"
        },
        "d": {
          "speaker": "elara",
          "text": "We found markings near the northern path.",
          "next": "e"
        },
        "e": {
          "speaker": "orin",
          "text": "Markings?",
          "actions": [
            {
              "type": "world_change",
              "id": "mc001_s004_sketch"
            }
          ],
          "next": "f"
        },
        "f": {
          "speaker": "orin",
          "text": "Where did you find that?",
          "next": "g"
        },
        "g": {
          "speaker": "primordial_steve",
          "text": "On a rock near the ridge.",
          "next": "h"
        },
        "h": {
          "speaker": "orin",
          "text": "That's not a natural crack."
        }
      }
    },
    "orin_pickaxe": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "orin",
          "text": "You can break most stone with a good pickaxe.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "That's usually the idea.",
          "next": "c"
        },
        "c": {
          "speaker": "orin",
          "text": "This time, don't.",
          "next": "d"
        },
        "d": {
          "speaker": "elara",
          "text": "He's serious, Steve.",
          "next": "e"
        },
        "e": {
          "speaker": "orin",
          "text": "Very serious. I want measurements before somebody destroys the evidence."
        }
      }
    },
    "not_normal": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "That's not normal.",
          "next": "b"
        },
        "b": {
          "speaker": "orin",
          "text": "Glad we've established that."
        }
      }
    }
  },
