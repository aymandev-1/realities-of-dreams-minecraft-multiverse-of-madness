  "dialogues": {
    "walk_bridge": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "You repaired the eastern bridge yesterday?",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Most of it. Bram helped with the supports.",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "You mean Bram watched while you did everything?",
          "next": "d"
        },
        "d": {
          "speaker": "primordial_steve",
          "text": "He carried the wood.",
          "next": "e"
        },
        "e": {
          "speaker": "elara",
          "text": "That's something, I suppose.",
          "actions": [
            {
              "type": "set_flag",
              "flag": "mc001.s001.walk1"
            }
          ]
        }
      }
    },
    "farmer_morning": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "firstbrook_farmer_1",
          "text": "Morning, Steve!",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Morning!",
          "next": "c"
        },
        "c": {
          "speaker": "elara",
          "text": "I wish every morning was this quiet.",
          "next": "d"
        },
        "d": {
          "speaker": "primordial_steve",
          "text": "Don't say that. Something always happens when somebody says that."
        }
      }
    },
    "feel_that": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "primordial_steve",
          "text": "Did you feel that?",
          "next": "b"
        },
        "b": {
          "speaker": "elara",
          "text": "Feel what?",
          "next": "c",
          "actions": [
            {
              "type": "shake",
              "intensity": 0.04,
              "ticks": 20
            },
            {
              "type": "sound",
              "sound": "minecraft:entity.lightning_bolt.thunder",
              "volume": 0.12,
              "pitch": 0.5
            }
          ]
        },
        "c": {
          "speaker": "primordial_steve",
          "text": "Probably nothing.",
          "next": "d",
          "actions": [
            {
              "type": "npc_look",
              "character": "elara",
              "location": "ridge"
            }
          ]
        },
        "d": {
          "speaker": "elara",
          "text": "I hope so."
        }
      }
    }
  },
