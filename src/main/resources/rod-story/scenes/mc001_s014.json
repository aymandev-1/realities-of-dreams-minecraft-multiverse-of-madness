  "dialogues": {
    "s14_arrival": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "elara",
          "text": "It's so bright.",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "That tower's been here longer than the city around it, if the stories are right.",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "Let's find Sahir."
        }
      }
    },
    "s14_city_water": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "sunspire_citizen_1",
          "text": "Water from the oasis, a copper a cup!"
        }
      }
    },
    "s14_city_quiet": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "solkar_scholar_1",
          "text": "Quiet in the stacks, please. The pages are older than your grandparents."
        }
      }
    },
    "s14_city_busy": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "sunspire_citizen_6",
          "text": "The House of Records hasn't been this busy since the eclipse year."
        }
      }
    },
    "s14_city_dates": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "sunspire_citizen_2",
          "text": "Dates and figs, sweet as the morning! Try one, traveller."
        }
      }
    },
    "s14_city_gate": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "sunspire_citizen_7",
          "text": "Welcome to Sunspire. Drink before you're thirsty out here."
        }
      }
    },
    "s14_city_terraces": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "sunspire_citizen_5",
          "text": "Mind the terraces at noon. You could bake bread on those roofs."
        }
      }
    },
    "s14_sahir": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "I recognised the symbol as soon as the Queen's messenger described it.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "You've seen it before?",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "Not with my own eyes. But I know where it's recorded.",
          "next": "l03"
        },
        "l03": {
          "speaker": "sahir",
          "text": "A survey conducted many generations ago mentioned a circle beneath six landmarks.",
          "next": "l04"
        },
        "l04": {
          "speaker": "orin",
          "text": "Six landmarks?",
          "next": "l05"
        },
        "l05": {
          "speaker": "sahir",
          "text": "Each corresponding to one of the great civilisations."
        }
      }
    },
    "s14_records": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "Why did nobody know about this before?",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "Because the records were incomplete. Some pages were lost, others misunderstood.",
          "next": "l02"
        },
        "l02": {
          "speaker": "elara",
          "text": "Could somebody have hidden them?",
          "next": "l03"
        },
        "l03": {
          "speaker": "sahir",
          "text": "Possibly. But missing information isn't proof of a conspiracy.",
          "next": "l04"
        },
        "l04": {
          "speaker": "orin",
          "text": "I'm starting to like him.",
          "next": "l05"
        },
        "l05": {
          "speaker": "sahir",
          "text": "Thank you. I think."
        }
      }
    },
    "s14_decoded": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "'Open the circle only in its hour. What is opened out of its hour will remember the hour it should have kept.'",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "Remember? Stone doesn't remember anything.",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "The people who wrote this seem to have thought otherwise."
        }
      }
    },
    "s14_warning_talk": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "This one is worse. 'The deep note holds the world in time. Strike it wrongly, and time will keep two answers.'",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "Two answers to what?",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "I wish I knew. The rest of the page is gone.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "The deep note... like the humming Liora's rangers heard?",
          "next": "l04"
        },
        "l04": {
          "speaker": "sahir",
          "text": "Perhaps."
        }
      }
    },
    "s14_central": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "There. That symbol represents a central structure.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "The northern monument?",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "Perhaps. But it appears that the monument is only one part of something much larger."
        }
      }
    },
    "s14_leads_back": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "Everything leads back there.",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "Then whatever was hidden beneath the valley was important enough for six civilisations to record."
        }
      }
    },
    "s14_crate_talk": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "The crate your caravan saved was bound for this house. Solkar's piece.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "The raiders were after it.",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "My family's oldest book says it was given to us to keep, not to understand. Given by the First Hands, whoever they were.",
          "next": "l03"
        },
        "l03": {
          "speaker": "sahir",
          "text": "Lord Kaelen of Emberhold has refused every letter about this. If Veyrath holds a piece, he won't give it up easily.",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "Then we'll ask him in person."
        }
      }
    }
  },
