  "dialogues": {
    "s19_pylon": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "These channels feed the ring. Every one of them."
        }
      }
    },
    "s19_console": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "thane_garrick",
          "text": "The bridge was built to carry weight. Something heavy was moved across it once."
        }
      }
    },
    "s19_base": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "sahir",
          "text": "Same glyphs as the Sunspire wall. 'In its hour.'"
        }
      }
    },
    "s19_rings": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "orin",
          "text": "Nobody touch anything.",
          "next": "l01"
        },
        "l01": {
          "speaker": "bram",
          "text": "Nobody is touching anything!",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "The structure is responding to something.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "The compass?",
          "next": "l04"
        },
        "l04": {
          "speaker": "orin",
          "text": "I don't think the compass is causing this."
        }
      }
    },
    "s19_surface": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "What... is that?",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "I don't know.",
          "next": "l02"
        },
        "l02": {
          "speaker": "sahir",
          "text": "None of the records described anything like this.",
          "next": "l03"
        },
        "l03": {
          "speaker": "elara",
          "text": "Steve, we have to leave.",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "I can see something.",
          "next": "l05"
        },
        "l05": {
          "speaker": "elara",
          "text": "Steve!"
        }
      }
    },
    "s19_collapse": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "elara",
          "text": "Steve! The bridge is collapsing!",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "The gateway's overloading! We need to evacuate!",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "Elara, I'm coming!",
          "next": "l03"
        },
        "l03": {
          "speaker": "elara",
          "text": "No! You'll get trapped too!",
          "next": "l04"
        },
        "l04": {
          "speaker": "primordial_steve",
          "text": "I'm not leaving you!",
          "next": "l05"
        },
        "l05": {
          "speaker": "bram",
          "text": "Come on, everyone! Move!",
          "next": "l06"
        },
        "l06": {
          "speaker": "liora",
          "text": "The upper passage is clear!",
          "next": "l07"
        },
        "l07": {
          "speaker": "thane_garrick",
          "text": "My engineers will hold the supports!"
        }
      }
    },
    "s19_rescue": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "Take my hand!",
          "next": "l01"
        },
        "l01": {
          "speaker": "elara",
          "text": "The floor's going!",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "I've got you."
        }
      }
    },
    "s19_stars": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "primordial_steve",
          "text": "Those stars...",
          "next": "l01"
        },
        "l01": {
          "speaker": "sahir",
          "text": "What about them?",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "I've never seen them before."
        }
      }
    },
    "s19_after": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "elara",
          "text": "Steve? Are you alright?",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "Yeah... I think so."
        }
      }
    },
    "s19_aftermath": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "bram",
          "text": "Everyone still alive?",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "I think so.",
          "next": "l02"
        },
        "l02": {
          "speaker": "primordial_steve",
          "text": "What did we just see?",
          "next": "l03"
        },
        "l03": {
          "speaker": "sahir",
          "text": "Something our ancestors may have understood.",
          "next": "l04"
        },
        "l04": {
          "speaker": "thane_garrick",
          "text": "Then why did they seal it?",
          "next": "l05"
        },
        "l05": {
          "speaker": "lord_kaelen",
          "text": "Perhaps because they knew exactly what would happen if it opened.",
          "next": "l06"
        },
        "l06": {
          "speaker": "primordial_steve",
          "text": "Or because they were afraid of something they couldn't explain.",
          "next": "l07"
        },
        "l07": {
          "speaker": "liora",
          "text": "Either way, we cannot pretend this didn't happen."
        }
      }
    }
  },
