  "dialogues": {
    "volunteers": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "Everyone listen! Nobody goes past the north marker without an escort.",
          "next": "b"
        },
        "b": {
          "speaker": "firstbrook_villager_2",
          "text": "It's just an old ruin.",
          "next": "c"
        },
        "c": {
          "speaker": "bram",
          "text": "Then you won't mind waiting until we know it's safe.",
          "next": "d"
        },
        "d": {
          "speaker": "bram",
          "text": "Good. I need somebody who knows how to build a proper barricade.",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "You could've just asked.",
          "next": "f"
        },
        "f": {
          "speaker": "bram",
          "text": "I was hoping you'd volunteer."
        }
      }
    },
    "rockfall": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "expedition_worker_1",
          "text": "Help! I can't get through!",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "Stay back from the rocks!",
          "next": "c"
        },
        "c": {
          "speaker": "bram",
          "text": "I'll clear the other side!"
        }
      }
    },
    "nicely_done": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "bram",
          "text": "Nicely done.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "We're lucky nobody got hurt.",
          "next": "c"
        },
        "c": {
          "speaker": "bram",
          "text": "Luck won't keep us safe forever."
        }
      }
    },
    "there_it_is": {
      "critical": true,
      "lines": {
        "a": {
          "speaker": "elara",
          "text": "There it is.",
          "next": "b"
        },
        "b": {
          "speaker": "primordial_steve",
          "text": "The ruins?",
          "next": "c"
        },
        "c": {
          "speaker": "orin",
          "text": "Not exactly. That structure doesn't match any record I've seen.",
          "next": "d"
        },
        "d": {
          "speaker": "elder_rowan",
          "text": "Then we proceed carefully.",
          "next": "e"
        },
        "e": {
          "speaker": "primordial_steve",
          "text": "We go tomorrow."
        }
      }
    }
  },
