  "dialogues": {
    "s16_maren": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "captain_maren",
          "text": "I'd have met you on the road, but the sea wasn't cooperative.",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "Have you got the fragment?",
          "next": "l02"
        },
        "l02": {
          "speaker": "captain_maren",
          "text": "Found it. Then the tremors brought half the old watch down on top of it.",
          "next": "l03"
        },
        "l03": {
          "speaker": "captain_maren",
          "text": "We found it beneath an old coastal watch structure.",
          "next": "l04"
        },
        "l04": {
          "speaker": "sahir",
          "text": "Then the same builders may have worked across all six territories."
        }
      }
    },
    "s16_caravan": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "captain_maren",
          "text": "I heard you helped a caravan outside Eldervale.",
          "next": "l01"
        },
        "l01": {
          "speaker": "primordial_steve",
          "text": "We were in the right place.",
          "next": "l02"
        },
        "l02": {
          "speaker": "captain_maren",
          "text": "The right place is usually where someone chooses to stand.",
          "next": "l03"
        },
        "l03": {
          "speaker": "primordial_steve",
          "text": "You sound like Rowan.",
          "next": "l04"
        },
        "l04": {
          "speaker": "captain_maren",
          "text": "Then Rowan sounds sensible."
        }
      }
    },
    "s16_dive": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "captain_maren",
          "text": "Follow the buoys out and keep to the bubble lines. Tidewatch divers have breathed off them for three hundred years."
        }
      }
    },
    "s16_anchor": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "captain_maren",
          "text": "The Tide Anchor. My grandfather swore it kept this coast from shaking.",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "Maybe it did. Look how it's made. It's meant to hold something steady."
        }
      }
    },
    "s16_new": {
      "critical": true,
      "lines": {
        "l00": {
          "speaker": "captain_maren",
          "text": "Well. That's new.",
          "next": "l01"
        },
        "l01": {
          "speaker": "orin",
          "text": "I think we've just found our next destination.",
          "next": "l02"
        },
        "l02": {
          "speaker": "captain_maren",
          "text": "I'll carry everyone to Valebridge myself. Every kingdom should be in one room for this."
        }
      }
    },
    "s16_ropes": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "tidewatch_dockhand_2",
          "text": "Watch your feet! Ropes everywhere this morning."
        }
      }
    },
    "s16_tide": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "thalassian_sailor_1",
          "text": "Tide's turning. If the Captain wants the divers out, it'll be soon."
        }
      }
    },
    "s16_catch": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "tidewatch_dockhand_5",
          "text": "Fresh catch! Cod, salmon, and one very angry crab."
        }
      }
    },
    "s16_nets": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "tidewatch_dockhand_3",
          "text": "Mending nets all morning. The tremors shook half of them off the hooks."
        }
      }
    },
    "s16_waiting": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "thalassian_sailor_3",
          "text": "We sail when the Captain says. Not a moment before."
        }
      }
    },
    "s16_old_watch": {
      "critical": false,
      "lines": {
        "l00": {
          "speaker": "tidewatch_dockhand_7",
          "text": "Heard the old watch go in the night. Sounded like the sea itself coughing."
        }
      }
    }
  },
